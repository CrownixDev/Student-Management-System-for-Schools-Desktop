{
  "name": "crownix-student-management-system-desktop",
  "productName": "Crownix Student Management System Desktop",
  "version": "1.1.0",
  "description": "A Crownix application for simplifying student management in Sri Lankan schools.",
  "main": "./out/main/index.js",
  "author": "Crownix",
  "homepage": "https://github.com/CrownixDev/Student-Management-System-for-Schools-Desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/CrownixDev/Student-Management-System-for-Schools-Desktop.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "build:win:dir": "pnpm run build && electron-builder --win --x64 --dir",
    "build:win": "pnpm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.71.0",
    "marked": "^18.2.0",
    "react-day-picker": "^10.0.2",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.21.0",
    "react-toastify": "^11.2.0",
    "recharts": "3.8.0",
    "semver": "^7.8.6",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
