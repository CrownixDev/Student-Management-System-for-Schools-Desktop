{
  "extends": "./node_modules/@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/types/**/*",
    "src/constraints/**/*",
    "src/lib/**/*"
, "resources/server/sqlite-check.cjs"  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
